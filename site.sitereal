      "id": "cmp-treatmentcard",
      "stylesheets": [
        {
          "id": "cmpcss-sheet-mw4t0jw9-2",
          "name": "TreatmentCard",
          "rules": [
            {
              "selector": ".treatment-card",
              "css": "display: flex; flex-direction: column; block-size: 100%; background: var(--neutral-100);"
            },
            {
              "selector": ".treatment-card__visual",
              "css": "position: relative; overflow: hidden; aspect-ratio: 4 / 4.5;"
            },
            {
              "selector": ".treatment-card__image",
              "css": "inline-size: 100%; block-size: 100%; object-fit: cover; transition: scale var(--motion-duration) var(--motion-ease); .treatment-card:hover & { scale: 1.04; } @media(prefers-reduced-motion: reduce){ transition: none; }"
            },
            {
              "selector": ".treatment-card__number",
              "css": "position: absolute; inset-block-start: var(--space-m); inset-inline-start: var(--space-m); padding: var(--space-xs); background: var(--neutral-100); color: var(--primary); font-size: var(--text-s);"
            },
            {
              "selector": ".treatment-card__body",
              "css": "display: flex; flex-direction: column; align-items: start; gap: var(--space-s); padding: var(--space-l) var(--space-m); flex: 1;"
            },
            {
              "selector": ".treatment-card__category",
              "css": "font-size: var(--text-xs); color: var(--primary);"
            },
            {
              "selector": ".treatment-card__title",
              "css": "font-size: var(--h3);"
            },
            {
              "selector": ".treatment-card__description",
              "css": "font-size: var(--text-s);"
            },
            {
              "selector": ".treatment-card__link",
              "css": "color: var(--primary); font-size: var(--text-s); padding-block-start: var(--space-m); text-underline-offset: .3em; margin-block-start: auto;"
            }
          ]
        }
      ],
      "shape": "plain"
    },

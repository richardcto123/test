            "color": "success",
            "on": true,
            "builtin": true
          },
          {
            "id": "warning",
            "label": "Warning",
            "kind": "color",
            "color": "warning",
            "on": true,
            "builtin": true
          },
          {
            "id": "info",
            "label": "Info",
            "kind": "color",
            "color": "info",
            "on": true,
            "builtin": true
          },
          {
            "id": "danger",
            "label": "Danger",
            "kind": "color",
            "color": "danger",
            "on": true,
            "builtin": true
          },
          {
            "id": "white",
            "label": "White",
            "kind": "color",
            "color": "white",
            "on": true,
            "builtin": true
          },
          {
            "id": "black",
            "label": "Black",
            "kind": "color",
            "color": "black",
            "on": true,
            "builtin": true
          },
          {
            "id": "theme",
            "label": "Theme",
            "kind": "color",
            "color": "primary",
            "themed": true,
            "on": true,
            "builtin": true
          },
          {
            "id": "outline",
            "label": "Outline",
            "kind": "style",
            "on": true,
            "builtin": true,
            "tokens": {
              "background": "transparent",
              "text-color": "var(--btn-tone)",
              "border-color": "var(--btn-tone)",
              "background-hover": "var(--btn-tone)",
              "text-color-hover": "var(--btn-tone-contrast)",
              "border-color-hover": "var(--btn-tone)",
              "shadow": "none"
            }
          },
          {
            "id": "soft",
            "label": "Soft",
            "kind": "style",
            "on": true,
            "builtin": true,
            "tokens": {
              "background": "var(--btn-tone-soft)",
              "text-color": "var(--btn-tone)",
              "border-color": "transparent",
              "background-hover": "var(--btn-tone)",
              "text-color-hover": "var(--btn-tone-contrast)",
              "shadow": "none"
            }
          },
          {
            "id": "text",
            "label": "Text",
            "kind": "style",
            "on": true,
            "builtin": true,
            "tokens": {
              "background": "transparent",
              "text-color": "var(--btn-tone)",
              "border-color": "transparent",
              "background-hover": "var(--btn-tone-soft)",
              "text-color-hover": "var(--btn-tone-hover)",
              "border-color-hover": "transparent",
              "shadow": "none",
              "padding-inline": "0.4em"
            }
          },
          {
            "id": "pill",
            "label": "Pill",
            "kind": "style",
            "on": true,
            "builtin": true,
            "tokens": {
              "border-radius": "999px"
            }
          },
          {
            "id": "block",
            "label": "Full width",
            "kind": "style",
            "on": true,
            "builtin": true,
            "tokens": {
              "width": "100%"
            }
          },
          {
            "id": "xs",
            "label": "Extra small",
            "kind": "size",
            "on": true,
            "builtin": true,
            "tokens": {
              "font-size": "var(--text-xs)",
              "padding-block": "0.5em",
              "padding-inline": "0.9em"
            }
          },
          {
            "id": "s",
            "label": "Small",
            "kind": "size",
            "on": true,
            "builtin": true,
            "tokens": {
              "font-size": "var(--text-s)",
              "padding-block": "0.65em",
              "padding-inline": "1.1em"
            }
          },
          {
            "id": "l",
            "label": "Large",
            "kind": "size",
            "on": true,
            "builtin": true,
            "tokens": {
              "font-size": "var(--text-l)",
              "padding-block": "0.9em",
              "padding-inline": "1.6em"
            }
          },
          {
            "id": "xl",
            "label": "Extra large",
            "kind": "size",
            "on": true,
            "builtin": true,
            "tokens": {
              "font-size": "var(--text-xl)",
              "padding-block": "1em",
              "padding-inline": "2em"
            }
          }
        ]
      },
      "bodyBg": "var(--white)",
      "radius": "12px",
      "imageRadius": "12px",
      "shadowStrength": 0.18,
      "motionDuration": 700,
      "motionEase": "smooth",
      "motionDistance": "32px",
      "motionStagger": 90,
      "motionPerspective": "900px",

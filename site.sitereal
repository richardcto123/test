      "stylesheets": [
        {
          "id": "tpl-sheet-mw4t05e1-1",
          "name": "Main",
          "rules": [
            {
              "selector": ".cvm-header",
              "css": "display: block; padding: 0; background: var(--white);"
            },
            {
              "selector": ".cvm-header__top",
              "css": "background: var(--base); color: var(--white); padding: var(--space-xs) var(--site-padding);"
            },
            {
              "selector": ".cvm-header__top-inner",
              "css": "max-inline-size: var(--content-width); margin-inline: auto; display: flex; justify-content: space-between; align-items: center; gap: var(--space-s); flex-wrap: wrap;"
            },
            {
              "selector": ".cvm-header__area",
              "css": "font-size: var(--text-xs);"
            },
            {
              "selector": ".cvm-header__phone",
              "css": "color: var(--white); text-decoration: none; font-size: var(--text-xs);"
            },
            {
              "selector": ".cvm-header__bar",
              "css": "max-inline-size: var(--content-width); margin-inline: auto; padding: var(--space-m) var(--site-padding); display: flex; align-items: center; justify-content: space-between; gap: var(--space-m); @media(max-width: 60rem){ flex-wrap: wrap; } @media(max-width: 35rem){ justify-content: center; }"
            },
            {
              "selector": ".cvm-header__brand",
              "css": "display: flex; flex-direction: column; gap: var(--space-xs); align-items: start; text-decoration: none;"
            },
            {
              "selector": ".cvm-header__logo",
              "css": "inline-size: clamp(11rem,18vw,15rem); block-size: auto;"
            },
            {
              "selector": ".cvm-header__descriptor",
              "css": "font-size: var(--text-xs); color: var(--primary);"
            },
            {
              "selector": ".cvm-nav",
              "css": "display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: var(--space-m); @media(max-width: 60rem){ gap: var(--space-s); }"
            },
            {
              "selector": ".cvm-nav__link",
              "css": "font-size: var(--text-s); color: var(--base); text-decoration: none; padding-block: var(--space-xs); &:hover { color: var(--primary); text-decoration: underline; }"
            },
            {
              "selector": ".cvm-header__cta",
              "css": "white-space: nowrap;"
            },
            {
              "selector": ".cvm-footer",
              "css": "display: block; background: var(--base); color: var(--white); padding: var(--section-space-s) var(--site-padding) var(--space-m);"
            },
            {
              "selector": ".cvm-footer__grid",
              "css": "max-inline-size: var(--content-width); margin-inline: auto; display: grid; grid-template-columns: 1.3fr .8fr 1fr; gap: var(--space-xl); @media(max-width: 48rem){ grid-template-columns: 1fr; }"
            },
            {
              "selector": ".cvm-footer__brand",
              "css": "display: flex; flex-direction: column; align-items: start; gap: var(--space-m);"
            },
            {
              "selector": ".cvm-footer__logo",
              "css": "inline-size: min(100%, 17rem); block-size: auto; background: var(--white); padding: var(--space-s); border-radius: var(--radius-s);"
            },
            {
              "selector": ".cvm-footer__name",
              "css": "font-size: var(--text-l); color: var(--white);"
            },
            {
              "selector": ".cvm-footer__description",
              "css": "font-size: var(--text-s); color: var(--white-80);"
            },
            {
              "selector": ".cvm-footer__column",
              "css": "display: flex; flex-direction: column; align-items: start; gap: var(--space-s); min-inline-size: 0;"
            },
            {
              "selector": ".cvm-footer__heading",
              "css": "font-size: var(--text-l); color: var(--white);"
            },
            {
              "selector": ".cvm-footer__link",
              "css": "font-size: var(--text-s); color: var(--white-80); text-decoration: none; overflow-wrap: anywhere; &:hover { color: var(--white); text-decoration: underline; }"
            },
            {
              "selector": ".cvm-footer__address",
              "css": "font-size: var(--text-s); color: var(--white-80);"
            },
            {
              "selector": ".cvm-footer__bottom",
              "css": "max-inline-size: var(--content-width); margin-inline: auto; margin-block-start: var(--space-xl); padding-block-start: var(--space-m); border-block-start: 1px solid var(--white-20); display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-s);"
            },
            {
              "selector": ".cvm-footer__copyright",
              "css": "font-size: var(--text-xs); color: var(--white-70);"
            },
            {
              "selector": ".cvm-footer__external",
              "css": "font-size: var(--text-xs); color: var(--white-80); text-underline-offset: .3em;"
            }
          ]
        }
      ],
      "applyTo": {
        "all": true
      }
    },

              "css": "color: var(--primary);"
            },
            {
              "selector": ".customer-review__quote",
              "css": "font-size: var(--text-l); margin: 0; color: var(--base);"
            },
            {
              "selector": ".customer-review__byline",
              "css": "display: flex; flex-direction: column; gap: var(--space-xxs); margin-block-start: auto;"
            },
            {
              "selector": ".customer-review__author",
              "css": "font-size: var(--text-m);"
            },
            {
              "selector": ".customer-review__context",
              "css": "font-size: var(--text-xs);"
            },
            {
              "selector": ".customer-review__source",
              "css": "font-size: var(--text-xs); color: var(--primary); text-underline-offset: .3em;"
            }
          ]
        }
      ],
      "id": "cmp-customerreview",
      "shape": "plain"
    }
  ],

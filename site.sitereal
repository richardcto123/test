      "stylesheets": [
        {
          "id": "global",
          "name": "Global",
          "rules": [
            {
              "selector": ".cvm-services",
              "css": "padding-block: var(--section-space-m); scroll-margin-block-start: var(--space-l);"
            },
            {
              "selector": ".cvm-about",
              "css": "padding-block: var(--section-space-m); scroll-margin-block-start: var(--space-l); background: var(--neutral-100);"
            },
            {
              "selector": ".cvm-fitting",
              "css": "padding-block: var(--section-space-m); scroll-margin-block-start: var(--space-l);"
            },
            {
              "selector": ".cvm-design",
              "css": "padding-block: var(--section-space-m); scroll-margin-block-start: var(--space-l); background: var(--primary-100);"
            },
            {
              "selector": ".cvm-process",
              "css": "padding-block: var(--section-space-m); scroll-margin-block-start: var(--space-l);"
            },
            {
              "selector": ".cvm-reviews",
              "css": "padding-block: var(--section-space-m); scroll-margin-block-start: var(--space-l); background: var(--neutral-100);"
            },

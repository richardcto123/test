            "kind": "color",
            "color": "base",
            "on": true,
            "builtin": true
          },
          {
            "id": "neutral",
            "label": "Neutral",
            "kind": "color",
            "color": "neutral",
            "on": true,
            "builtin": true
          },
          {
            "id": "success",
            "label": "Success",

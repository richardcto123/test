        {
          "tag": "section",
          "classes": [
            "cvm-faq"
          ],
          "attrs": {
            "builder-data-element": "section",
            "id": "faqs"
          },
          "name": "cvm faq",
          "id": "section-mw4tj6et-1621",
          "children": [
            {
              "tag": "div",
              "classes": [
                "cvm-faq__container"
              ],
              "attrs": {
                "builder-data-element": "div"
              },
              "name": "container",
              "id": "div-mw4tj6et-1622",
              "children": [
                {
                  "tag": "div",
                  "classes": [
                    "cvm-faq__intro"
                  ],
                  "attrs": {
                    "builder-data-element": "div"
                  },
                  "name": "intro",
                  "id": "div-mw4tj6et-1623",
                  "children": [
                    {
                      "tag": "p",
                      "classes": [
                        "cvm-faq__eyebrow"
                      ],
                      "text": "BEFORE YOU BEGIN",
                      "attrs": {
                        "builder-data-element": "text"
                      },
                      "name": "eyebrow",
                      "id": "p-mw4tj6et-1624"
                    },
                    {
                      "tag": "h2",
                      "classes": [
                        "cvm-faq__title"
                      ],
                      "text": "Your bathroom<br>questions, answered.",
                      "attrs": {
                        "builder-data-element": "heading"
                      },
                      "name": "title",
                      "id": "h2-mw4tj6et-1625"
                    },
                    {
                      "tag": "p",
                      "classes": [
                        "cvm-faq__text"
                      ],
                      "text": "Planning a bathroom refit in Solihull? Here are a few useful starting points. For advice about your own room, speak to Chris.",
                      "attrs": {
                        "builder-data-element": "text"
                      },
                      "name": "text",
                      "id": "p-mw4tj6et-1626"
                    },
                    {
                      "tag": "a",
                      "classes": [
                        "cvm-faq__call"
                      ],
                      "attrs": {
                        "builder-data-element": "link",
                        "href": "tel:07748601792"
                      },
                      "text": "Call 07748 601792 ↗",
                      "name": "call",
                      "id": "a-mw4tj6et-1627"
                    }
                  ]
                },
                {
                  "tag": "div",
                  "classes": [
                    "cvm-faq__list"
                  ],
                  "attrs": {
                    "builder-data-element": "div"
                  },
                  "name": "list",
                  "id": "div-mw4tj6et-1628",
                  "children": [
                    {
                      "tag": "details",
                      "classes": [
                        "cvm-faq__item"
                      ],
                      "attrs": {
                        "builder-data-element": "div",
                        "open": ""
                      },
                      "name": "item",
                      "id": "details-mw4tj6et-1629",
                      "children": [
                        {
                          "tag": "summary",
                          "classes": [
                            "cvm-faq__question"
                          ],
                          "text": "Do you fit bathrooms in Solihull?",
                          "name": "question",
                          "id": "summary-mw4tj6et-1630",
                          "attrs": {
                            "builder-data-element": "text"
                          }
                        },
                        {
                          "tag": "p",
                          "classes": [
                            "cvm-faq__answer"
                          ],
                          "text": "Yes. C.V.M Plumbing & Bathrooms is based in Solihull and provides bathroom fitting and refurbishment services locally. Share your postcode when you enquire so we can confirm availability for your property.",
                          "attrs": {
                            "builder-data-element": "text"
                          },
                          "name": "answer",
                          "id": "p-mw4tj6et-1631"
                        }
                      ]
                    },
                    {
                      "tag": "details",
                      "classes": [
                        "cvm-faq__item"
                      ],
                      "name": "item",
                      "id": "details-mw4tj6et-1632",
                      "attrs": {
                        "builder-data-element": "div"
                      },
                      "children": [
                        {
                          "tag": "summary",
                          "classes": [
                            "cvm-faq__question"
                          ],
                          "text": "Can you help with bathroom design as well as fitting?",
                          "name": "question",
                          "id": "summary-mw4tj6et-1633",
                          "attrs": {
                            "builder-data-element": "text"
                          }
                        },
                        {
                          "tag": "p",
                          "classes": [
                            "cvm-faq__answer"
                          ],
                          "text": "Yes. We can discuss the layout, fixtures and finishes alongside the practical installation work. Whether you have a clear design in mind or need help comparing options, the starting point is understanding your space and how you use it.",
                          "attrs": {
                            "builder-data-element": "text"
                          },
                          "name": "answer",
                          "id": "p-mw4tj6et-1634"
                        }
                      ]
                    },
                    {
                      "tag": "details",
                      "classes": [
                        "cvm-faq__item"
                      ],
                      "name": "item",
                      "id": "details-mw4tj6et-1635",
                      "attrs": {
                        "builder-data-element": "div"
                      },
                      "children": [
                        {
                          "tag": "summary",
                          "classes": [
                            "cvm-faq__question"
                          ],
                          "text": "How much does a bathroom refurbishment cost?",
                          "name": "question",
                          "id": "summary-mw4tj6et-1636",
                          "attrs": {
                            "builder-data-element": "text"
                          }
                        },
                        {
                          "tag": "p",
                          "classes": [
                            "cvm-faq__answer"
                          ],
                          "text": "The cost depends on the room size, suite and finishes, the condition of existing plumbing and any changes to the layout. Contact Chris to discuss the work and arrange an assessment so the quote reflects your bathroom.",
                          "attrs": {
                            "builder-data-element": "text"
                          },
                          "name": "answer",
                          "id": "p-mw4tj6et-1637"
                        }
                      ]
                    },
                    {
                      "tag": "details",
                      "classes": [
                        "cvm-faq__item"
                      ],
                      "name": "item",
                      "id": "details-mw4tj6et-1638",
                      "attrs": {
                        "builder-data-element": "div"
                      },
                      "children": [
                        {
                          "tag": "summary",
                          "classes": [
                            "cvm-faq__question"
                          ],
                          "text": "How long will my bathroom installation take?",
                          "name": "question",
                          "id": "summary-mw4tj6et-1639",
                          "attrs": {
                            "builder-data-element": "text"
                          }
                        },
                        {
                          "tag": "p",
                          "classes": [
                            "cvm-faq__answer"
                          ],
                          "text": "Timescales depend on the amount of work, product availability and any issues uncovered when the old bathroom is removed. Your proposed schedule should be discussed before work begins, with updates if the scope changes.",
                          "attrs": {
                            "builder-data-element": "text"
                          },
                          "name": "answer",
                          "id": "p-mw4tj6et-1640"
                        }
                      ]
                    },
                    {
                      "tag": "details",
                      "classes": [
                        "cvm-faq__item"
                      ],
                      "name": "item",
                      "id": "details-mw4tj6et-1641",
                      "attrs": {
                        "builder-data-element": "div"
                      },
                      "children": [
                        {
                          "tag": "summary",
                          "classes": [
                            "cvm-faq__question"
                          ],
                          "text": "Can you work on a small bathroom or en suite?",
                          "name": "question",
                          "id": "summary-mw4tj6et-1642",
                          "attrs": {
                            "builder-data-element": "text"
                          }
                        },
                        {
                          "tag": "p",
                          "classes": [
                            "cvm-faq__answer"
                          ],
                          "text": "Yes. Careful planning can make a compact bathroom or en suite more practical. We can discuss storage, shower positions and fixture sizes to help you make better use of the available space.",
                          "attrs": {
                            "builder-data-element": "text"
                          },
                          "name": "answer",
                          "id": "p-mw4tj6et-1643"
                        }
                      ]
                    },
                    {
                      "tag": "details",
                      "classes": [
                        "cvm-faq__item"
                      ],
                      "name": "item",
                      "id": "details-mw4tj6et-1644",
                      "attrs": {
                        "builder-data-element": "div"
                      },
                      "children": [
                        {
                          "tag": "summary",
                          "classes": [
                            "cvm-faq__question"
                          ],
                          "text": "What should I have ready before requesting a quote?",
                          "name": "question",
                          "id": "summary-mw4tj6et-1645",
                          "attrs": {
                            "builder-data-element": "text"
                          }
                        },
                        {
                          "tag": "p",
                          "classes": [
                            "cvm-faq__answer"
                          ],
                          "text": "A few photos, your approximate room dimensions, your postcode and an outline of what you want to change are a useful start. If you have selected products or set a budget, include those details too.",
                          "attrs": {
                            "builder-data-element": "text"
                          },
                          "name": "answer",
                          "id": "p-mw4tj6et-1646"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },

{
  "format": "sitereal",
  "version": 2,
  "site": {
    "name": "C.V.M Plumbing & Bathrooms",
    "lang": "en-GB",
    "favicon": "/favicon.svg",
    "seo": {
      "titleTemplate": "%s | %site",
      "sitemap": true,
      "robots": true
    },
    "hosting": {
      "actions": {
        "github": true,
        "host": false
      },
      "how": "git"
    }
  },
  "addons": {},
  "framework": {
    "enabled": true,
    "config": {
      "modules": {},
      "colors": {
        "primary": {
          "hex": "#78b90d",
          "on": true
        },
        "secondary": {
          "hex": "#22c55e",
          "on": false
        },
        "tertiary": {
          "hex": "#a855f7",
          "on": false
        },
        "accent": {
          "hex": "#da0e4e",
          "on": true
        },
        "base": {
          "hex": "#273a24",
          "on": true
        },
        "neutral": {
          "hex": "#F5F6F6",
          "on": true
        },
        "success": {
          "hex": "#22c55e",
          "on": false
        },
        "warning": {
          "hex": "#f59e0b",
          "on": false
        },
        "info": {
          "hex": "#3b82f6",
          "on": false
        },
        "danger": {
          "hex": "#ef4444",
          "on": false
        },
        "white": {
          "hex": "#ffffff",
          "on": true
        },
        "black": {
          "hex": "#000000",
          "on": true
        }
      },
      "unifiedLightness": null,
      "transparencyVars": true,
      "shadeVars": true,
      "shadeStops": {
        "ultraLight": 95,
        "light": 85,
        "medium": 50,
        "dark": 25,
        "ultraDark": 10,
        "hover": -8
      },
      "minVw": 375,
      "maxVw": 1440,
      "rootFontSize": 100,
      "typeMinSize": 16,
      "typeMinRatio": 1.2,
      "typeMaxSize": 18,
      "typeMaxRatio": 1.25,
      "headingMinSize": 18,
      "headingMinRatio": 1.2,
      "headingMaxSize": 20,
      "headingMaxRatio": 1.28,
      "sizeOverrides": {
        "h1": {
          "min": 36,
          "max": 64
        },
        "h2": {
          "min": 30,
          "max": 46
        },
        "h3": {
          "min": 23,
          "max": 30
        }
      },
      "colorOverrides": {},
      "headingFont": "system-ui, sans-serif",
      "textFont": "system-ui, sans-serif",
      "textSize": "var(--text-m)",
      "textColor": "var(--base)",
      "textWeight": 400,
      "textLineHeight": "1.6",
      "headingWeight": 700,
      "headingLineHeight": "1.08",
      "headingColor": "var(--base)",
      "spaceMinSize": 16,
      "spaceMinRatio": 1.5,
      "spaceMaxSize": 24,
      "spaceMaxRatio": 1.5,
      "sectionMinSize": 40,
      "sectionMinRatio": 1.5,
      "sectionMaxSize": 64,
      "sectionMaxRatio": 1.5,
      "contentWidth": "76rem",
      "containerSpacing": "var(--space-l)",
      "contentSpacing": "var(--space-m)",
      "layoutFluid": false,
      "contentWidthMin": 640,
      "contentWidthMax": 1280,
      "borderWidth": "1px",
      "borderLight": "var(--neutral-200)",
      "borderDark": "var(--neutral-400)",
      "elementStyles": {},
      "buttons": {
        "baseClass": "btn",
        "tokens": {
          "border-radius": "6px"
        },
        "variants": [
          {
            "id": "primary",
            "label": "Primary",
            "kind": "color",
            "color": "primary",
            "on": true,
            "builtin": true
          },
          {

  "snippets": [
    {
      "name": "CVM business and FAQ structured data",
      "lang": "html",
      "placement": "head",
      "applyTo": {
        "routes": [
          "index"
        ]
      },
      "enabled": true,
      "code": "<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Plumber\",\"@id\":\"https://bathroomfittersinsolihull.co.uk/#business\",\"name\":\"C.V.M Plumbing & Bathrooms\",\"url\":\"https://bathroomfittersinsolihull.co.uk/\",\"logo\":\"https://bathroomfittersinsolihull.co.uk/wp-content/uploads/2025/09/CVMClogo-300x78.png\",\"image\":\"https://bathroomfittersinsolihull.co.uk/wp-content/uploads/2025/09/74f558_4ef3f401e4a2400a8979c42d1a7ba1a7mv2_d_5760_3840_s_4_2.avif\",\"telephone\":\"+447748601792\",\"email\":\"cvminstallations@gmail.com\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"2 Lingham Close\",\"addressLocality\":\"Solihull\",\"addressRegion\":\"West Midlands\",\"postalCode\":\"B92 9NW\",\"addressCountry\":\"GB\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"Solihull\"},\"hasOfferCatalog\":{\"@type\":\"OfferCatalog\",\"name\":\"Bathroom services\",\"itemListElement\":[{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Bathroom fitting\",\"areaServed\":\"Solihull\"}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Bathroom design\",\"areaServed\":\"Solihull\"}}]}},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Do you fit bathrooms in Solihull?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. C.V.M Plumbing & Bathrooms is based in Solihull and provides bathroom fitting and refurbishment services locally. Share your postcode when you enquire so we can confirm availability for your property.\"}},{\"@type\":\"Question\",\"name\":\"Can you help with bathroom design as well as fitting?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. We can discuss the layout, fixtures and finishes alongside the practical installation work. Whether you have a clear design in mind or need help comparing options, the starting point is understanding your space and how you use it.\"}},{\"@type\":\"Question\",\"name\":\"How much does a bathroom refurbishment cost?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The cost depends on the room size, suite and finishes, the condition of existing plumbing and any changes to the layout. Contact Chris to discuss the work and arrange an assessment so the quote reflects your bathroom.\"}},{\"@type\":\"Question\",\"name\":\"How long will my bathroom installation take?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Timescales depend on the amount of work, product availability and any issues uncovered when the old bathroom is removed. Your proposed schedule should be discussed before work begins, with updates if the scope changes.\"}},{\"@type\":\"Question\",\"name\":\"Can you work on a small bathroom or en suite?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Careful planning can make a compact bathroom or en suite more practical. We can discuss storage, shower positions and fixture sizes to help you make better use of the available space.\"}},{\"@type\":\"Question\",\"name\":\"What should I have ready before requesting a quote?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A few photos, your approximate room dimensions, your postcode and an outline of what you want to change are a useful start. If you have selected products or set a budget, include those details too.\"}}]}]}</script>",
      "id": "snip-cvm-business-and-faq-structured-data"
    }
  ],
